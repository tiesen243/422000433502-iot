  <diagram id="x5O6ZwcPIrDNa7HZVqGT" name="lab_2">
    <mxGraphModel dx="2911" dy="864" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Lưu đồ giải thuật - Giám sát cảm biến và điều khiển LED\n\nskinparam activity {\n    BackgroundColor white\n    BorderColor black\n    DiamondBackgroundColor white\n    DiamondBorderColor black\n    RoundCorner 0\n}\n\nstart\n\n:Khởi tạo biến và thiết bị\n{\n  INTERVAL: 1 giây;\n  EVENT_DURATION: 3 giây;\n  DHT11;\n  ADC;\n  LCD;\n  Ultrasonic;\n  LED đỏ, vàng, xanh;\n  led_states: dict;\n};\n\nwhile (Chương trình đang chạy?) is (Có)\n\n    :Đọc nhiệt độ và độ ẩm từ DHT11;\n\n    if (Đọc cảm biến thành công?) then (Có)\n\n        :Đọc cảm biến ánh sáng;\n        :Đọc điện áp biến trở;\n        :Đo khoảng cách bằng Ultrasonic;\n\n        :Chuyển dữ liệu cảm biến sang kiểu float;\n\n        :Khởi tạo danh sách sự kiện LED;\n\n        :Kiểm tra ngưỡng từng LED\n        {\n          LED đỏ: Nhiệt độ;\n          LED vàng: Độ ẩm;\n          LED xanh: Điện áp biến trở;\n        };\n\n        if (Giá trị vượt ngưỡng bật?) then (Có)\n            :Đặt trạng thái LED = ON;\n        else (Không)\n            if (Giá trị thấp hơn ngưỡng tắt?) then (Có)\n                :Đặt trạng thái LED = OFF;\n            else (Không)\n                :Giữ nguyên trạng thái LED;\n            endif\n        endif\n\n        if (Trạng thái LED thay đổi?) then (Có)\n            :Cập nhật trạng thái LED;\n            :Ghi trạng thái mới ra GPIO;\n            :Thêm sự kiện vào danh sách;\n        endif\n\n        :Hiển thị thông tin cảm biến\\nvà trạng thái LED lên Terminal;\n\n        if (Có sự kiện LED?) then (Có)\n\n            while (Còn sự kiện LED?) is (Có)\n                :Hiển thị trạng thái LED\\nvà giá trị cảm biến lên LCD;\n                :In thông tin sự kiện ra Terminal;\n                :Chờ 3 giây;\n            endwhile (Không)\n\n        endif\n\n        :Hiển thị nhiệt độ, độ ẩm,\\nánh sáng và khoảng cách lên LCD;\n\n        :Chờ 1 giây;\n\n    else (Không)\n\n        :Thông báo lỗi đọc DHT11;\n        :Chờ 1 giây;\n\n    endif\n\nendwhile (Không)\n\n:Đặt tất cả LED về trạng thái OFF;\n:Hiển thị Program Stopped lên LCD;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QAHlc1QbHDlZek-PDO-N-1">
