      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;\n@startuml\ntitle Lưu đồ giải thuật - Giám sát nhiệt độ và độ ẩm\n\nskinparam activity {\n    BackgroundColor white\n    BorderColor black\n    DiamondBackgroundColor white\n    DiamondBorderColor black\n    RoundCorner 0\n}\n\nstart\n\n:Khởi tạo biến và thiết bị\\n\n{\n  start_time: float;\n  last_avg_time: float;\n  temp_sum: float = 0.0;\n  humi_sum: float = 0.0;\n  count: int = 0;\n  DHT11;\n  LCD;\n};\n\nwhile (Thời gian chạy &lt; 30 phút?) is (Có)\n\n    :Đọc nhiệt độ và độ ẩm;\n\n    if (Đọc cảm biến thành công?) then (Có)\n\n        :Chuyển dữ liệu sang kiểu float;\n        :Hiển thị nhiệt độ và độ ẩm hiện tại lên LCD;\n\n        :Cộng dồn nhiệt độ và độ ẩm;\n        :Tăng biến đếm count;\n\n        if (Thời gian tính trung bình &gt;= 20 giây?) then (Có)\n\n            :Tính nhiệt độ trung bình;\n            :Tính độ ẩm trung bình;\n            :Hiển thị giá trị trung bình lên LCD;\n\n            :Gửi dữ liệu lên ThingSpeak;\n\n            if (Gửi dữ liệu thành công?) then (Có)\n                :Thông báo gửi dữ liệu thành công;\n            else (Không)\n                :Thông báo lỗi gửi dữ liệu;\n            endif\n\n            :Đặt lại temp_sum, humi_sum, count;\n            :Cập nhật last_avg_time;\n\n        endif\n\n        :Chờ 2 giây;\n\n    else (Không)\n\n        :Thông báo lỗi đọc cảm biến;\n        :Chờ 2 giây;\n\n    endif\n\nendwhile (Không)\n\n:Xóa nội dung LCD;\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8fIjliHw3u78jsp4wHLM-127">
